    "./style.css": "./src/radar.css",
    "./vite": "./src/vite.ts"
  },
  "dependencies": {
    "@simon-lumikello/meanwhile-ui": "workspace:*",
    "@simon-lumikello/meanwhile-weather": "workspace:*",
