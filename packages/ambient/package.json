{
  "name": "@simon-lumikello/meanwhile-ambient",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts",
    "./react": "./src/react.ts",
    "./style.css": "./src/ambient.css"
  },
  "dependencies": {
    "@simon-lumikello/meanwhile-weather": "workspace:*",
